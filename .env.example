# Copy to .env at repo root (and/or apps/web/.env.local)

DATABASE_URL="postgresql://lienradar:lienradar@localhost:5432/lienradar?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# South Florida counties for calendars / PA (comma-separated). Default = miami-dade,broward,palm-beach,monroe
# LR_ACTIVE_COUNTIES="miami-dade,broward,palm-beach,monroe"

# Free OCS docket runs without a key. Optional paid Official Records / Developers API:
# MIAMI_DADE_CLERK_AUTH_KEY=""

# RealAuction residential proxy (optional — use if datacenter IP gets 403)
# Prefer HTTP for Playwright/Chromium; SOCKS as fallback.
# RA_HTTP_PROXY="http://USER:PASS@HOST:PORT"
# RA_PROXY="socks5://USER:PASS@HOST:PORT"

# Optional future: Census / RealForeclose login (guest path does not need these)
# CENSUS_API_KEY=""
# RF_USER=""
# RF_PASS=""

# PUBLIC_BROWSE="false"
